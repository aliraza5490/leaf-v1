{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Backend: FastAPI",
      "type": "debugpy",
      "request": "launch",
      "python": "${workspaceFolder}/backend/.venv/bin/python",
      "module": "uvicorn",
      "args": ["app.main:app", "--reload", "--host", "0.0.0.0", "--port", "8000"],
      "cwd": "${workspaceFolder}/backend",
      "env": {
        "PYTHONUNBUFFERED": "1",
        "VIRTUAL_ENV": "${workspaceFolder}/backend/.venv",
        "PATH": "${workspaceFolder}/backend/.venv/bin:${env:PATH}"
      },
      "justMyCode": true
    },
    {
      "name": "Backend: FastAPI (uv run)",
      "type": "node-terminal",
      "request": "launch",
      "command": "uv run uvicorn app.main:app --reload --host 0.0.0.0 --port 8000",
      "cwd": "${workspaceFolder}/backend"
    },
    {
      "name": "Frontend: Next.js",
      "type": "node-terminal",
      "request": "launch",
      "command": "pnpm dev",
      "cwd": "${workspaceFolder}/frontend",
      "serverReadyAction": {
        "action": "openExternally",
        "pattern": "Local:.*http://localhost:([0-9]+)",
        "uriFormat": "http://localhost:%s"
      }
    },
    {
      "name": "Frontend: Debug Chrome",
      "type": "chrome",
      "request": "launch",
      "url": "http://localhost:3000",
      "webRoot": "${workspaceFolder}/frontend",
      "sourceMaps": true,
      "sourceMapPathOverrides": {
        "webpack:///./~/*": "${workspaceFolder}/frontend/node_modules/*",
        "webpack://?./*": "${workspaceFolder}/frontend/*"
      }
    }
  ],
  "compounds": [
    {
      "name": "Full Stack",
      "configurations": ["Backend: FastAPI (uv run)", "Frontend: Next.js"],
      "stopAll": true
    }
  ]
}